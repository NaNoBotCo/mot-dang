.DS_Store
__pycache__/
*.pyc
cache/
.claude/

# never commit the LINE channel token
.mot-dang-line-token
*.token
.dev.vars

# scratch: files moved here for the user to delete (this mount forbids rm)
_to_delete/
_incoming/

# app build artifacts — regenerate with app/build_data.py + app/build_apk.py;
# the signed APK the site serves is the copy in docs/app/
app/out/
app/www/data/

# The basemap archive: 116 MB, over GitHub's 100 MB per-file limit and pointless
# in git anyway (it is a build artifact of a dated Protomaps planet build — the
# exact command is recorded in data/basemap.json). Lives in R2; regenerate with
# that command if it is ever lost.
assets/tiles/*.pmtiles
docs/tiles/

# Publishing state and local tool caches. The tooling in publish/ is tracked;
# what it leaves behind is not. .wrangler/ in particular caches a Cloudflare
# request trace that carries the coordinates, postcode and ISP of whoever last
# ran a deploy — a public repo is the wrong home for the deployer's front door.
# .uploaded.json is a per-machine checksum ledger of the last sync.
publish/.wrangler/
publish/.uploaded.json

# The Hugging Face dataset repo: a build artifact of the canonical data, the
# same way docs/ is. make_hf_dataset.py is tracked; its 12 MB of output is not.
publish/hf-dataset/
cache/scripture/

# WO-41: ingest sidecars — per-machine operational state, rewritten every
# run like cache/last-published.json. A fresh clone with no meta is a
# supported state (ingest.read_meta returns {}).
data/*.meta.json
