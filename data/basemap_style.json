    {
      "id": "water",
      "type": "fill",
      "source": "p",
      "source-layer": "water",
      "_note": "THE FILTER IS REQUIRED, not decoration — deleting it puts the Ping 600 m wide again. Rivers, streams and canals live in this same source-layer as LineStrings (see water-line below), and a MapLibre fill layer does NOT skip non-polygon geometry: it treats each line as a ring, closes it, and fills the lobe between the meander and its own closing chord. Measured 2026-08-21 over a 13 km frame at z14: 8.73 km2 of real water, 19.34 km2 of phantom. map_ground.py guards the same thing with 'if gt == 3'. Safe as plain equality because a vector-tile feature carries a numeric type, so geometry-type only ever returns Point/LineString/Polygon — never MultiPolygon.",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#7FB5E0"
      }
    },
