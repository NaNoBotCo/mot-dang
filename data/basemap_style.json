          [
            "get",
            "kind"
          ],
          "forest",
          "#CFE0B4",
          "grassland",
          "#DCE8C6",
          "scrub",
          "#D8E4C0",
          "farmland",
          "#ECE8CC",
          "#E6E2C8"
